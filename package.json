    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "LuckyTortle",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
