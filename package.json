{
  "name": "tortle-bot",
  "private": true,
  "version": "1.0.0",
  "description": "A Discord bot named Tortle Bot",
  "main": "dist/index.mjs",
  "type": "module",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
